# Stripe API credentials (Dashboard -> Developers -> API keys)
# Use a *restricted* key scoped to only Invoices + Invoice Items (write), not the full account key.
STRIPE_SECRET_KEY=sk_live_or_test_your_key_here
STRIPE_CUSTOMER_ID=cus_xxxxxxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxx
# Optional: Stripe invoice rendering template. Leave blank to omit.
STRIPE_TEMPLATE_ID=

# Your client/business name, used only in Stripe invoice metadata.
CLIENT_NAME=Your Client Name

# Name of the recurring macOS Calendar event that signals "create an invoice today".
# Falls back to date math (see PERIOD_DAYS/ANCHOR_INVOICE_DATE) if no such event is found.
CALENDAR_EVENT_NAME=Create Invoice

# Billing terms - edit these to match your actual contract.
HOURS_PER_PERIOD=40
PERIOD_DAYS=14
DUE_DAYS_AFTER_INVOICE=14
# How many days before the invoice date the billed service period starts. Defaults to
# PERIOD_DAYS - 3 if unset (11 for the default 14-day period). That default assumes a Friday
# invoice date with a Monday start, which only holds for 7- or 14-day Friday cadences. It is a
# heuristic, not a universal rule - if your invoice day or weekend policy differs, set this
# explicitly rather than relying on the default.
SERVICE_DAYS_BEFORE_INVOICE=11
# First invoice date in the recurring series (YYYY-MM-DD). Every later period is PERIOD_DAYS after this.
ANCHOR_INVOICE_DATE=2026-01-01

# Text shown on the invoice and the invoice line item.
INVOICE_DESCRIPTION=Consulting services. Review and update memo before sending.
INVOICE_ITEM_DESCRIPTION=Consulting services
